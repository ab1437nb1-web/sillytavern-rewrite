{
  "name": "dsh-sillytavern",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SillyTavern character cards, world info (lorebooks) and chat presets for DeepSeek Harness",
  "exports": {
    "./characters": "./characters/index.js",
    "./worldbook": "./worldbook/index.js",
    "./presets": "./presets/index.js",
    "./persona": "./persona/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "characters",
    "worldbook",
    "presets",
    "persona",
    "lib",
    "client",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/plugin.mjs && node test/client.mjs && node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

